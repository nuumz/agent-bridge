# run logs (prompt, peer JSON, stderr) — per-run evidence, regrows on every call
runs/

# generated by bin/bridge-sync from ~/.claude/CLAUDE.md — regenerable, never edit
mirror/

# manual backups
.bak-*/

# python / editor / macOS
__pycache__/
*.pyc
.DS_Store
.idea/
.vscode/

# shared board (SQLite, dispatch logs) — runtime state
board/

# named multi-turn threads (transcripts + peer session ids) — runtime state
conv/

# bridge-panel runtime output (per-panel transcripts) — like conv/
panel/

# bridge-live state, broker log and peer stream per live peer — runtime state
live/

# cursor read-only deny bookkeeping (holds a copy of ~/.cursor/cli-config.json)
cursor-deny.json
cursor-deny.lock
quota/
ledger.jsonl
agreements/
agreements.archived/
work/

# machine-local skill packs (project-specific) — not for remote
work-skills.local/
