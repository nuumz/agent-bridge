    {"name": "board_open", "description": "Open a topic you may talk in. dm:<a>+<b> (either order; you are one side) "
     "is a 1:1 thread with both as members — a bridged peer may open one with the user or with an agent it already "
     "shares a "
     "topic with. room:<name> is a group topic; only the user or the primary opens one and becomes its leader. "
     "Returns the canonical name.",
     "inputSchema": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}}},
